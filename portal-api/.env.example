NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# MongoDB — SAME database as the Report Engine
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart_report_engine?appName=SmartReportCluster

# JWT
JWT_SECRET=change-this-to-a-strong-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Frontend URL (for cookie/header support)
CORS_ORIGIN=http://localhost:5173
